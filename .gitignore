# ---------------------------------------------------------------------------
# Godot 4
# ---------------------------------------------------------------------------
# Carpeta de caché e importaciones que Godot regenera en cada máquina.
# Los archivos *.import que están junto a cada asset SÍ se versionan: guardan
# los ajustes de importación y el UID, y si se pierden Godot los regenera con
# UIDs nuevos y se rompen las referencias.
.godot/

# Proyecto exportado / builds
/build/
/builds/
/export/
/exports/
*.exe
*.pck
*.zip
*.apk
*.aab
*.dmg
*.app

# OJO: export_presets.cfg SÍ se versiona a propósito. El build de Docker exporta el
# proyecto dentro del contenedor y necesita el preset "Linux Server". Si algún día
# se agrega un preset con claves de firma (keystore de Android, contraseñas), hay
# que sacarlas de ahí — nunca ignorar el archivo completo, o se rompe el despliegue.

# Android (si algún día se agrega el template de exportación)
/android/

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Editores
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# Dirección del servidor horneada al compilar (la escribe tools/build_windows.sh).
# No se versiona: es de cada despliegue, no del proyecto.
/server_url.txt
